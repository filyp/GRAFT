# Python / tooling
__pycache__/
*.pyc
.venv/
.venvs/
.pytest_cache/
*.egg-info/
wandb/
*.log
.DS_Store

# Secrets (sft/.env.example is tracked; real .env files are not)
.env
*.env

# rl/: run outputs, rendered figures, extracted figure-input bundle
rl/output/
rl/figures/figs/
rl/final_figures/
rl/paper_data/output/
rl/paper_data/respmon-results/

# sft/: checkpoints, logs, eval build products, rendered charts, prepared data
sft/checkpoints/
sft/logs/
sft/build/merged/
sft/build/eval-dataset/
sft/build/logs/
sft/build/vllm.pid
# Eval jobs: only the released job dirs are tracked. New jobs (e.g. the
# setup_box.sh smoke-* job) are ignored; their config.json records absolute paths.
sft/build/jobs/*/
!sft/build/jobs/base-qwen3-32b-*/
!sft/build/jobs/gr-s1like-*/
!sft/build/jobs/gr-split-*/
sft/build/jobs/*/*__*/
sft/charts/*.png
sft/charts/*.pdf
sft/data/*.jsonl

# selectivity experiment: derived eval outputs (regenerable from the adapters) and Shadeform box state
selectivity/results/
selectivity/box/box_state*.json

# sft/build/jobs_new: jobs pulled from Shadeform boxes. Track only the K2 job summaries scored in
# reports/2026.10.29_sft.md (result.json, judge_scores_judge_v3.json, subset_tasks.txt); trajectories, configs
# (box-absolute paths), logs, smoke jobs and the copies of the released sft/build/jobs/* are ignored.
sft/build/jobs_new/*
!sft/build/jobs_new/k2-*/
!sft/build/jobs_new/base-k2-*/
sft/build/jobs_new/*/*__*/
sft/build/jobs_new/*/config.json
sft/build/jobs_new/*/job.log
